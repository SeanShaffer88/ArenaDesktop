<Window x:Class="ArenaDesktop.TerminalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Terminal — project folder"
        Width="860" Height="540" MinWidth="560" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
    <Grid Margin="14,12,14,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="FolderText" Grid.Row="0" Margin="0,0,0,8"
                   Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/>
        <TextBox x:Name="OutputBox" Grid.Row="1" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"
                 AutomationProperties.Name="Terminal output"/>
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="CommandBox" Grid.Column="0" FontFamily="Consolas" KeyDown="OnCommandKeyDown"
                     AutomationProperties.Name="Command to run"/>
            <Button Grid.Column="1" Content="Run" Click="OnRun" Margin="8,0,0,0" AutomationProperties.Name="Run command"/>
            <Button x:Name="StopButton" Grid.Column="2" Content="Stop" Click="OnStop" IsEnabled="False" Margin="6,0,0,0"
                    AutomationProperties.Name="Stop running command"/>
        </Grid>
    </Grid>
</Window>
