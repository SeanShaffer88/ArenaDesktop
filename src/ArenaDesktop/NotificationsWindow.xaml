<Window x:Class="ArenaDesktop.NotificationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notifications"
        Width="680" Height="520" MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
    <Window.Resources>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>
    <Grid Margin="14,12,14,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Style="{StaticResource Note}"
                   Text="The durable record of what ArenaDesktop itself noticed: downloads, local tasks (terminal, Git), scratch comparisons, and app events. Balloons still follow the quiet-hours / Do Not Disturb policy; this list keeps everything either way."/>
        <ListBox x:Name="EntriesList" Grid.Row="1" Margin="0,10,0,8"
                 Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"
                 AutomationProperties.Name="Notifications"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Categories:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <StackPanel x:Name="CategoryPanel" Orientation="Horizontal"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Orientation="Horizontal">
            <Button Content="Mark all read" Click="OnMarkAllRead" Margin="0,0,6,0" AutomationProperties.Name="Mark all notifications read"/>
            <Button Content="Clear all" Click="OnClear" AutomationProperties.Name="Clear all notifications"/>
            <TextBlock x:Name="UnreadText" Style="{StaticResource Note}" Margin="10,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
