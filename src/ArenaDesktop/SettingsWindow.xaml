<Window x:Class="ArenaDesktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ArenaDesktop"
        Title="ArenaDesktop Settings" AutomationProperties.Name="ArenaDesktop Settings"
        Width="860" Height="820" MinWidth="800" MinHeight="600" MaxHeight="1000"
        ResizeMode="CanResize" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
    <Window.Resources>
        <local:ProfileColorBrushConverter x:Key="ProfileColorBrush"/>
        <!-- Section titles are white; the red lives in the short rule
             under each one (added beside the header in the markup).
             The search highlight still washes the header's own
             Background, so the header keeps its Padding. -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Padding" Value="6,2"/>
        </Style>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="15"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <!-- Group labels inside a section ("Clear browsing data:" …). -->
        <Style x:Key="SubHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin" Value="0,14,0,4"/>
        </Style>
        <!-- Each section is a card. The card IS the section's named
             container (not a Border wrapped around it) so the search
             filter's Visibility toggle still hides the whole card. -->
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <!-- Fields and buttons paint from the shared tokens only, so
             the light theme and High Contrast keep working. S6 #51:
             window-local styles must not lose the focus visual. -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource RaisedBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource ShellFocusVisual}"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource RaisedBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource ShellFocusVisual}"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource RaisedBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource ShellFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource FaintBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource RaisedBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource ShellFocusVisual}"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="2,2,2,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource ShellFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SurfaceBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AccentFillBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource FaintBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource ShellFocusVisual}"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource ShellFocusVisual}"/>
        </Style>
    </Window.Resources>

    <DockPanel KeyboardNavigation.TabNavigation="Continue" KeyboardNavigation.ControlTabNavigation="Continue">
        <!-- Settings search filters the left navigation and highlights matched pages. -->
        <StackPanel DockPanel.Dock="Top" Margin="18,14,18,0">
            <TextBlock Text="Search settings:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="SettingsSearchText" TextChanged="OnSearchTextChanged" PreviewKeyDown="OnSearchPreviewKeyDown"
                     AutomationProperties.Name="Search Settings controls" AutomationProperties.HelpText="Type to filter the section list and controls. Down and Up browse matching controls; Enter moves focus to one."
                     ToolTip="Search for a setting or control — matching sections stay in the left list; Down/Up browse controls and Enter jumps to one"/>
            <TextBlock x:Name="SearchSummary" Style="{StaticResource Note}"
                       AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Settings search results"/>
            <!-- v0.13.0: a panel that cannot be read says so here. Settings is
                 the window a user opens *because* something is wrong; it must
                 not be the window that refuses to open. -->
            <Border x:Name="LoadFailureBanner" Visibility="Collapsed" Margin="0,10,0,0"
                    AutomationProperties.Name="Settings load warning" AutomationProperties.LiveSetting="Assertive"
                    Padding="12,10" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="6">
                <StackPanel Orientation="Horizontal">
                    <Border Width="3" CornerRadius="1.5" Background="{StaticResource AccentBrush}" Margin="0,0,10,0"/>
                    <StackPanel>
                        <TextBlock Text="Some settings could not be shown." FontWeight="SemiBold"/>
                        <TextBlock x:Name="LoadFailureDetail" Style="{StaticResource Note}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- OK / Cancel stay pinned at the bottom, below navigation and
             the selected settings page, so they are always reachable. -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource HairlineBrush}"
                BorderThickness="0,1,0,0" Padding="18,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="OK" Width="86" Height="30" IsDefault="True" Click="OnOk"
                        Background="{StaticResource AccentFillBrush}" Foreground="{StaticResource AccentTextBrush}" BorderThickness="0"/>
                <Button Content="Cancel" Width="86" Height="30" Margin="8,0,0,0" IsCancel="True"/>
            </StackPanel>
        </Border>

        <Grid Margin="16,10,16,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="8" Margin="0,0,12,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="SECTIONS" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource MutedBrush}" Margin="8,4,0,8"/>
                    <ListBox x:Name="SectionNavigation" SelectionChanged="OnSectionNavigationChanged"
                             DisplayMemberPath="Title" BorderThickness="0"
                             AutomationProperties.Name="Settings sections"
                             KeyboardNavigation.TabNavigation="Continue"/>
                </DockPanel>
            </Border>
            <ScrollViewer x:Name="SettingsScroller" Grid.Column="1"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="SectionsPanel" Margin="0,0,10,0">
                <Border x:Name="SectionBehavior" Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock x:Name="HeaderBehavior" Text="Behavior" Style="{StaticResource SectionHeader}"/>
                        <Border Height="2" Width="44" CornerRadius="1" Background="{StaticResource AccentBrush}"
                                HorizontalAlignment="Left" Margin="6,0,0,10"/>
                        <CheckBox x:Name="StartWithWindowsCheck" Content="Start with Windows"
                                  ToolTip="Launch ArenaDesktop when you sign in to Windows (the usual per-user Run entry)"/>
                        <CheckBox x:Name="StartMinimizedCheck" Content="When starting with Windows, open in the tray (not on screen)"
                                  ToolTip="Only affects the sign-in launch: on = ArenaDesktop waits in the tray; off = the window opens like a normal launch. Double-clicking the app always opens the window"/>
                        <CheckBox x:Name="CloseToTrayCheck" Content="Close window to tray (instead of quitting)"
                                  ToolTip="The X button hides the window; Exit lives on the tray menu"/>
                        <CheckBox x:Name="SuspendInTrayCheck" Content="Save memory while hidden in the tray"
                                  ToolTip="After the time below, the web view is suspended until you come back. Suspend never happens during a download, and stays out of the way after the microphone has been used (a voice session may be live)"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,0">
                            <TextBlock Text="Suspend after hidden for:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="SuspendTimeoutCombo" Width="130"
                                      ToolTip="How long the window may sit hidden in the tray before the web view suspends"/>
                        </StackPanel>
                        <CheckBox x:Name="CheckUpdatesCheck" Content="Check for updates when the app starts"
                                  ToolTip="One silent request to GitHub Releases per launch; failures are ignored"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,0">
                            <TextBlock Text="Check automatically:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="UpdateFrequencyCombo" Width="210"
                                      ToolTip="How often the automatic check runs. The ⋯ menu's Check for updates always works, whatever this says"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,0">
                            <TextBlock Text="Release channel:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="UpdateChannelCombo" Width="210"
                                      ToolTip="Stable releases only, or also pre-releases (test builds). Stable users are never offered a pre-release"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Note}"
                                   Text="Pre-releases are unfinished test builds: they can contain bugs and half-finished features. Only choose the pre-release channel if you want to help test. Switching back to Stable offers you the next stable release — it never downgrades you on its own."/>
                        <CheckBox x:Name="ShowWhatsNewCheck" Content="Show “What's New” the first time a new version runs"
                                  ToolTip="After an update, the new version's release notes open once. The window itself also has a “don't show again” box"/>
                        <TextBlock x:Name="UpdateSnoozeNote" Style="{StaticResource Note}"/>
                        <Button x:Name="StopSnoozeButton" Content="Stop snoozing update reminders" Width="210" HorizontalAlignment="Left"
                                Margin="0,4,0,0" Click="OnStopUpdateSnooze" Visibility="Collapsed"
                                ToolTip="Cancel the snooze set from the update window (Remind me tomorrow / next week)"/>
                        <!-- Modes pack (v0.3.0): the startup mode + favorite
                             modes. The startup choice only picks the mode
                             page a launch opens with when it would land on
                             the Arena home page anyway — each profile's own
                             start page (Account profiles) still wins. -->
                        <TextBlock Style="{StaticResource Note}" Margin="0,14,0,2"
                                   Text="Arena modes — pick the mode ArenaDesktop opens with, and pin up to three favorites. Favorites come first in the tray's Arena modes menu and the taskbar Jump List."/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,0">
                            <TextBlock Text="Startup mode:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="StartupModeCombo" Width="190" SelectionChanged="OnStartupModeChanged"
                                      ToolTip="Which Arena mode a launch opens with when it starts at the Arena home page. A profile's restored last page or custom start page (Account profiles) still wins"/>
                            <ComboBox x:Name="StartupSpecificModeCombo" Width="150" Margin="8,0,0,0"
                                      ToolTip="The mode to open with when “A specific mode” is chosen"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,0">
                            <TextBlock Text="Favorite modes:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="FavoriteMode1Combo" Width="120"
                                      ToolTip="First favorite mode — leads the tray menu and the Jump List"/>
                            <ComboBox x:Name="FavoriteMode2Combo" Width="120" Margin="8,0,0,0"
                                      ToolTip="Second favorite mode"/>
                            <ComboBox x:Name="FavoriteMode3Combo" Width="120" Margin="8,0,0,0"
                                      ToolTip="Third favorite mode"/>
                        </StackPanel>
                        <!-- S11 #99: arenadesktop:// links. The installer
                             registers the scheme; this toggle keeps the
                             registration in line with it (and is how
                             portable installs register). The status line
                             reports the ACTUAL registration — including
                             when another app owns the scheme, which is
                             never overwritten. -->
                        <TextBlock Style="{StaticResource Note}" Margin="0,14,0,2"
                                   Text="Links — links that start with arenadesktop:// can open ArenaDesktop at a fixed set of places (the window, Home, Settings, Downloads, Help, or a profile). A link can never carry a web address or open anything else, and while the app is locked, links wait until you unlock."/>
                        <CheckBox x:Name="ProtocolLinksCheck" Content="Let arenadesktop:// links open ArenaDesktop" Margin="0,2,0,0"
                                  ToolTip="Register ArenaDesktop as the handler for arenadesktop:// links for your Windows user account"/>
                        <TextBlock x:Name="ProtocolStatus" Style="{StaticResource Note}" Foreground="{StaticResource AccentBrush}"/>
                        <Button Content="Run the setup wizard again…" Width="210" HorizontalAlignment="Left"
                                Margin="0,10,0,0" Click="OnRunSetupWizard"
                                ToolTip="Re-run the one-screen first-run setup (close-to-tray, start with Windows, downloads folder, update checks)"/>
                        <TextBlock Style="{StaticResource Note}"
                                   Text="Changes apply when you choose OK. Start-with-Windows writes the usual per-user Run entry; nothing here phones home beyond the update check you control."/>
                    </StackPanel>
                </Border>

                <Border x:Name="SectionTray" Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock x:Name="HeaderTray" Text="Tray &amp; notifications" Style="{StaticResource SectionHeader}"/>
                        <Border Height="2" Width="44" CornerRadius="1" Background="{StaticResource AccentBrush}"
                                HorizontalAlignment="Left" Margin="6,0,0,10"/>
                        <CheckBox x:Name="TraySingleClickCheck" Content="Single-click the tray icon to reopen (instead of double-click)"
                                  ToolTip="On: one click on the tray icon brings the window back. Off: double-click, as always"/>
                        <CheckBox x:Name="FlashOnAttentionCheck" Content="Flash the taskbar button when Arena needs attention while I'm away"
                                  ToolTip="When Arena's title shows an unread count (like (2) Arena) and you're not looking at the window, the taskbar button flashes a few times — it never steals focus. Off by default"/>
                        <CheckBox x:Name="QuietHoursCheck" Content="Quiet hours: keep ArenaDesktop's balloons and flashes silent"
                                  ToolTip="During quiet hours ArenaDesktop shows no tray balloons and no taskbar flash (the suppression is written to the log, never silent). Your Windows Do Not Disturb setting is always respected too"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,0">
                            <TextBlock Text="Quiet from:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="QuietStartCombo" Width="90"
                                      ToolTip="Quiet hours begin (on the hour)"/>
                            <TextBlock Text="to:" VerticalAlignment="Center" Margin="12,0,8,0"/>
                            <ComboBox x:Name="QuietEndCombo" Width="90"
                                      ToolTip="Quiet hours end (on the hour) — earlier than the start is fine; the window wraps midnight"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Note}"
                                   Text="Arena's own in-page notifications are governed by Windows and Arena, not by these settings. The tray icon also shows your active profile's accent color as a small dot, and an unread-count badge when Arena's title provides one."/>
                    </StackPanel>
                </Border>

                <Border x:Name="SectionProfiles" Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock x:Name="HeaderProfiles" Text="Account profiles" Style="{StaticResource SectionHeader}"/>
                        <Border Height="2" Width="44" CornerRadius="1" Background="{StaticResource AccentBrush}"
                                HorizontalAlignment="Left" Margin="6,0,0,10"/>
                        <ComboBox x:Name="ProfileCombo" SelectionChanged="OnProfileSelectionChanged"
                                  ToolTip="Sign-in profiles — each keeps its own Arena session">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center"
                                                 Fill="{Binding DisplayColor, Converter={StaticResource ProfileColorBrush}}"/>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Style="{StaticResource Note}" Margin="0,8,0,2"
                                   Text="Name (rename the selected profile):"/>
                        <TextBox x:Name="ProfileNameText" LostFocus="OnProfileNameLostFocus"
                                 ToolTip="The selected profile's name, shown in menus and the tray"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,0,0">
                            <TextBlock Text="Accent color:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="ProfileColorCombo" Width="140" SelectionChanged="OnProfileColorChanged"
                                      ToolTip="A small color dot next to this profile's name in menus, the tray, and here"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Note}" Margin="0,10,0,0"
                                   Text="When this profile starts:"/>
                        <RadioButton x:Name="ProfileStartLastRadio" GroupName="ProfileStartPage"
                                     Content="Reopen the page it was last on" Checked="OnProfileStartModeChanged"
                                     ToolTip="The profile picks up where it left off (the long-standing behavior)"/>
                        <RadioButton x:Name="ProfileStartHomeRadio" GroupName="ProfileStartPage"
                                     Content="Start at the Arena home page" Checked="OnProfileStartModeChanged"
                                     ToolTip="This profile always opens at Arena's home page"/>
                        <RadioButton x:Name="ProfileStartCustomRadio" GroupName="ProfileStartPage"
                                     Content="Start at a specific Arena page:" Checked="OnProfileStartModeChanged"
                                     ToolTip="This profile opens at the arena.ai page below — validated before use; an address ArenaDesktop can't open falls back to the home page"/>
                        <TextBox x:Name="ProfileCustomUrlText" Margin="18,4,0,0" LostFocus="OnProfileCustomUrlLostFocus"
                                 ToolTip="A arena.ai page address, e.g. https://arena.ai/chat/… — only Arena pages are accepted"/>
                        <TextBlock x:Name="ProfileCustomUrlNote" Style="{StaticResource Note}" Margin="18,2,0,0"/>
                        <CheckBox x:Name="ProfileZoomCheck" Content="Use a custom zoom for this profile"
                                  Checked="OnProfileZoomChanged" Unchecked="OnProfileZoomChanged"
                                  ToolTip="On: this profile zooms independently. Off: it uses the shared default zoom below. Zooming in the app updates the custom zoom while it's on"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,0">
                            <TextBlock Text="Profile zoom:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="ProfileZoomCombo" Width="90" SelectionChanged="OnProfileZoomComboChanged"
                                      ToolTip="This profile's own zoom (used while the custom-zoom box above is ticked)"/>
                        </StackPanel>
                        <TextBlock x:Name="ProfileDataText" Style="{StaticResource Note}" Margin="0,8,0,0"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,0,0">
                            <TextBlock Text="Data size cap:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="ProfileDataCapCombo" Width="150" SelectionChanged="OnProfileDataCapChanged"
                                      ToolTip="Optional cap on this profile's data folder. When the folder passes the cap, only disposable caches are emptied (oldest first) — cookies and sign-ins are never touched"/>
                        </StackPanel>
                        <TextBlock x:Name="ProfileCapNote" Style="{StaticResource Note}"/>
                        <TextBlock Style="{StaticResource Note}" Margin="0,8,0,2"
                                   Text="Downloads folder for this profile (optional — overrides the shared folder below):"/>
                        <DockPanel LastChildFill="True">
                            <Button x:Name="ClearProfileFolderButton" DockPanel.Dock="Right" Content="Clear" Width="56" Margin="8,0,0,0"
                                    Click="OnClearProfileDownloadsFolder"
                                    ToolTip="Remove this profile's downloads-folder override"/>
                            <Button x:Name="BrowseProfileFolderButton" DockPanel.Dock="Right" Content="Browse…" Width="76" Margin="8,0,0,0"
                                    Click="OnBrowseProfileDownloadsFolder"/>
                            <TextBox x:Name="ProfileDownloadsFolderText" IsReadOnly="True"
                                     ToolTip="This profile's downloads land here; empty uses the shared Downloads folder"/>
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button x:Name="SwitchProfileButton" Content="Switch to this profile" Width="150" Click="OnSwitchProfile"
                                    ToolTip="Restarts ArenaDesktop signed in with the selected profile"/>
                            <Button x:Name="RemoveProfileButton" Content="Remove" Width="76" Margin="8,0,0,0" Click="OnRemoveProfile"
                                    ToolTip="Removes the profile; its local sign-in data is deleted when you choose OK"/>
                            <Button x:Name="CreateShortcutButton" Content="Create desktop shortcut" Width="164" Margin="8,0,0,0" Click="OnCreateProfileShortcut"
                                    ToolTip="Puts a shortcut on the Desktop that opens ArenaDesktop with this profile"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button x:Name="ExportProfileSettingsButton" Content="Export profile settings…" Width="176"
                                    Click="OnExportProfileSettings" AutomationProperties.Name="Export selected profile settings"
                                    ToolTip="Export this profile's preferences only. Sign-in cookies and site data are not included."/>
                            <Button x:Name="ImportProfileSettingsButton" Content="Restore profile settings…" Width="184" Margin="8,0,0,0"
                                    Click="OnImportProfileSettings" AutomationProperties.Name="Restore settings into the selected profile"
                                    ToolTip="Restore preferences into this profile without changing its sign-in or profile id. Site data is not included."/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Note}" Margin="0,2,0,0"
                                   Text="Profile exports include its name, start page, downloads folder, color, zoom and data cap. They do not contain cookies or sign-ins."/>
                        <Button x:Name="OpenProfileDataFolderButton" Content="Open this profile’s site-data folder…" Width="250"
                                HorizontalAlignment="Left" Margin="0,6,0,0" Click="OnOpenProfileDataFolder"
                                AutomationProperties.Name="Open selected profile site-data folder"
                                ToolTip="Open the selected profile's WebView2 folder. Exit ArenaDesktop fully before copying or restoring files there."/>
                        <TextBlock Style="{StaticResource Note}" Margin="0,2,0,0"
                                   Text="For sign-in cookies and site data, copy this folder only after ArenaDesktop is fully exited. Restore only while it is closed, under the same Windows user on the same PC; Windows usually cannot decrypt these cookies on another PC or account."/>
                        <TextBlock x:Name="ProfileNote" Style="{StaticResource Note}"
                                   AutomationProperties.Name="Profile operation status" AutomationProperties.LiveSetting="Polite"/>
                        <TextBlock Style="{StaticResource Note}" Margin="0,8,0,2"
                                   Text="New profile — optionally copy settings (start page, downloads folder, zoom, color) from an existing one. Sign-ins are never copied:"/>
                        <ComboBox x:Name="CopyFromCombo" SelectionChanged="OnCopyFromChanged"
                                  ToolTip="Copy the new profile's settings from this profile; its sign-in is never copied"/>
                        <DockPanel LastChildFill="True" Margin="0,6,0,0">
                            <Button x:Name="AddProfileButton" DockPanel.Dock="Right" Content="Add" Width="76" Margin="8,0,0,0"
                                    Click="OnAddProfile"/>
                            <TextBox x:Name="NewProfileNameText" ToolTip="Name for a new profile, e.g. Work"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Note}"
                                   Text="Each profile is a separate Arena sign-in (its own cookies and data on this PC). Switching restarts the app immediately, discarding other unsaved changes in this window. You can't remove the profile you're currently using."/>
                    </StackPanel>
                </Border>

                <Border x:Name="SectionAppearance" Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock x:Name="HeaderAppearance" Text="Appearance &amp; toolbar" Style="{StaticResource SectionHeader}"/>
                        <Border Height="2" Width="44" CornerRadius="1" Background="{StaticResource AccentBrush}"
                                HorizontalAlignment="Left" Margin="6,0,0,10"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Shell theme:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="ThemeCombo" Width="170"
                                      ToolTip="Dark is the family black/red identity; Light is a light shell; Follow Windows matches your Windows app theme. Arena's page itself is never restyled"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6,0,0">
                            <TextBlock Text="Accent color:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="AccentCombo" Width="170"
                                      ToolTip="Colors ArenaDesktop's own highlights (section titles, buttons). Each accent is checked for readable contrast on both shell themes. This is separate from profile colors"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Note}" Margin="0,10,0,0"
                                   Text="Pinned mode: one mode ArenaDesktop keeps a one-click jump to in the status bar and the ⋯ menu. Pin the page you are on from ⋯ → Pin this mode."/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,0">
                            <TextBlock x:Name="PinnedModeText" VerticalAlignment="Center" Margin="0,0,8,0"
                                       Text="Nothing pinned."/>
                            <Button x:Name="UnpinModeButton" Content="Unpin" Width="76" Height="26" Click="OnUnpinModeSetting"
                                    ToolTip="Stop offering the pinned mode" Visibility="Collapsed"/>
                        </StackPanel>
                        <!-- Hardening pack: the clipboard is shared state, so
                             clearing it is offered, explained, and off by default. -->
                        <TextBlock Style="{StaticResource Note}" Margin="0,14,0,0"
                                   Text="A copied prompt stays on the Windows clipboard until something replaces it. Clearing it after a delay limits how long it sits there for other apps and clipboard-history tools."/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,0">
                            <TextBlock Text="Clear copied prompts after:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="ClipboardClearCombo" Width="120"
                                      ToolTip="Only text ArenaDesktop copied is cleared — anything you copied afterwards is left alone"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6,0,0">
                            <TextBlock Text="Shell text size:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="TextScaleCombo" Width="170"
                                      ToolTip="Scales ArenaDesktop's own text (toolbar, menus, Settings) — separate from page zoom. The tray menu is drawn by Windows and keeps its system size"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6,0,0">
                            <TextBlock Text="Shell layout:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="LayoutCombo" Width="170"
                                      ToolTip="Standard is the classic toolbar and status bar. Compact Focus gives the page more room: a slim toolbar, and the status bar becomes a small pill in the corner. Left Rail moves navigation and the Arena modes into a slim rail down the left edge, with a thin title strip on top and the status bar along the bottom. New installs start in Compact Focus; a layout you pick here (or in the ⋯ menu) is always kept"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Note}"
                                   Text="Theme, accent, layout, and text size restyle ArenaDesktop's own windows only — never the Arena page."/>
                        <TextBlock Style="{StaticResource Note}" Margin="0,10,0,2"
                                   Text="Toolbar buttons — tick to show, select then move with ↑ / ↓ (the ⋯ menu is always there, last):"/>
                        <ListBox x:Name="ToolbarList" Height="148"
                                 Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"
                                 BorderBrush="{StaticResource HairlineBrush}"
                                 ToolTip="The main window's toolbar buttons, in order, grouped as they appear (Back…Home on the left, zoom…browser on the right)"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="↑ Move up" Width="92" Click="OnToolbarMoveUp"/>
                            <Button Content="↓ Move down" Width="98" Margin="8,0,0,0" Click="OnToolbarMoveDown"/>
                            <Button Content="Reset layout" Width="104" Margin="8,0,0,0" Click="OnToolbarReset"
                                    ToolTip="Back to the standard toolbar: every button shown, in the original order"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Note}"
                                   Text="Back always stays — the toolbar must always offer navigation."/>
                        <CheckBox x:Name="DimToolbarCheck" Content="Dim the toolbar while I'm reading"
                                  Checked="OnDimToolbarChanged" Unchecked="OnDimToolbarChanged"
                                  Margin="0,10,0,0"
                                  ToolTip="Cools the toolbar down to a faint presence while the Arena page has focus"/>
                        <TextBlock Style="{StaticResource Note}"
                                   Text="The toolbar returns to full strength when you point at it or tab back into the shell. The Arena page itself is never affected."/>
                        <!-- Hardening pack: the status bar is a visual surface;
                             this lets a screen-reader user hear its outcomes. -->
                        <CheckBox x:Name="SpeakStatusCheck" Content="Announce status messages to screen readers"
                                  Checked="OnSpeakStatusChanged" Unchecked="OnSpeakStatusChanged"
                                  Margin="0,12,0,0"
                                  ToolTip="Speaks ordinary outcomes — a copy that failed, a refused link, a saved setting — through the polite live region"/>
                        <TextBlock Style="{StaticResource Note}"
                                   Text="Download and update events are announced either way. This only widens that to everyday status-bar outcomes; progress lines stay silent so they never talk over the page."/>
                    </StackPanel>
                </Border>

                <Border x:Name="SectionZoom" Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock x:Name="HeaderZoom" Text="Zoom" Style="{StaticResource SectionHeader}"/>
                        <Border Height="2" Width="44" CornerRadius="1" Background="{StaticResource AccentBrush}"
                                HorizontalAlignment="Left" Margin="6,0,0,10"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Default zoom:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="ZoomCombo" Width="90"
                                      ToolTip="The shared default zoom — applies at OK and is where the toolbar zoom starts next launch"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Note}"
                                   Text="Applies immediately at OK and is where the toolbar zoom starts next launch."/>
                        <CheckBox x:Name="ExtendedZoomCheck" Content="Extended zoom range (25%–500%)"
                                  Checked="OnExtendedZoomChanged" Unchecked="OnExtendedZoomChanged"
                                  ToolTip="Widens the zoom range and its steps for low-vision use: 25% to 500% instead of the standard 50% to 200%"/>
                        <TextBlock Style="{StaticResource Note}"
                                   Text="Zoom steps get finer near 100% either way; the extended range adds the extremes."/>
                    </StackPanel>
                </Border>

                <!-- Keyboard & accessibility (v0.10.0, S6) -->
                <Border x:Name="SectionAccessibility" Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock x:Name="HeaderAccessibility" Text="Keyboard &amp; accessibility" Style="{StaticResource SectionHeader}"/>
                        <Border Height="2" Width="44" CornerRadius="1" Background="{StaticResource AccentBrush}"
                                HorizontalAlignment="Left" Margin="6,0,0,10"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Reduce motion:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="ReduceMotionCombo" Width="190"
                                      ToolTip="Follow Windows reads the Windows animation-effects setting; On keeps the shell's effects off regardless">
                                <ComboBoxItem Content="Follow Windows"/>
                                <ComboBoxItem Content="On (reduce motion)"/>
                                <ComboBoxItem Content="Off (full motion)"/>
                            </ComboBox>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Note}"
                                   Text="ArenaDesktop's shell has almost no animation of its own; this setting quiets the one effect it does have — the taskbar attention flash. Animation inside the Arena page follows Windows' own setting."/>
                        <TextBlock Style="{StaticResource Note}" Margin="0,10,0,2"
                                   Text="Changeable shortcuts — click a key button, then press the new combination (it must include Ctrl or Alt). Reset puts one key back to its default:"/>
                        <StackPanel x:Name="ShortcutRows"/>
                        <TextBlock x:Name="ShortcutStatus" Style="{StaticResource Note}" AutomationProperties.Name="Shortcut editor status" AutomationProperties.LiveSetting="Polite" Foreground="{StaticResource AccentBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="All shortcuts…" Width="130" Click="OnOpenShortcutsList"
                                    ToolTip="Open the searchable list of every shortcut (Ctrl+/)"/>
                            <Button Content="Reset all keys" Width="120" Margin="8,0,0,0" Click="OnResetAllShortcuts"
                                    ToolTip="Put every changed shortcut back to its default"/>
                        </StackPanel>
                        <!-- S11 #96: the global show/hide hotkey. It lives
                             OUTSIDE the in-app shortcut list above on
                             purpose: it is registered with Windows itself
                             and works while other apps have focus; Core's
                             GlobalHotkey checks the two systems against
                             each other so they can never share a key. -->
                        <TextBlock Style="{StaticResource Note}" Margin="0,14,0,2"
                                   Text="Global hotkey — registered with Windows, so it works while any app has focus. Click the key button, then press the new combination (it must include Ctrl or Alt):"/>
                        <CheckBox x:Name="GlobalHotkeyCheck" Content="Show or hide ArenaDesktop with a global hotkey" Margin="0,2,0,0"
                                  ToolTip="Press the combination anywhere to bring ArenaDesktop forward; press it again to hide it to the tray"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button x:Name="GlobalHotkeyButton" MinWidth="170" Click="OnCaptureGlobalHotkey"
                                    ToolTip="The current global hotkey combination — click, then press a new one"/>
                            <Button Content="Reset" Width="80" Margin="8,0,0,0" Click="OnResetGlobalHotkey"
                                    ToolTip="Put the global hotkey back to the default, Ctrl+Alt+A"/>
                        </StackPanel>
                        <TextBlock x:Name="GlobalHotkeyStatus" Style="{StaticResource Note}" AutomationProperties.Name="Global hotkey status" AutomationProperties.LiveSetting="Polite" Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Style="{StaticResource Note}"
                                   Text="The default is Ctrl+Alt+A. If another app already uses the combination, registration fails and the status line above says so — pick a different one. While the app is locked, the hotkey only ever shows the lock screen."/>
                    </StackPanel>
                </Border>

                <Border x:Name="SectionDownloads" Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock x:Name="HeaderDownloads" Text="Downloads" Style="{StaticResource SectionHeader}"/>
                        <Border Height="2" Width="44" CornerRadius="1" Background="{StaticResource AccentBrush}"
                                HorizontalAlignment="Left" Margin="6,0,0,10"/>
                        <DockPanel LastChildFill="True">
                            <Button x:Name="BrowseFolderButton" DockPanel.Dock="Right" Content="Browse…" Width="76" Margin="8,0,0,0"
                                    Click="OnBrowseDownloadsFolder"/>
                            <TextBox x:Name="DownloadsFolderText" IsReadOnly="True"
                                     ToolTip="Where downloads are saved"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Note}"
                                   Text="Empty means your Windows Downloads folder. Changing it does not move files already downloaded."/>
                        <TextBlock x:Name="DownloadsFolderHealthText" Style="{StaticResource Note}" Margin="0,4,0,0"
                                   Text="" Visibility="Collapsed"
                                   AutomationProperties.Name="Downloads folder check"
                                   ToolTip="A quick check of whether downloads can land in that folder right now"/>
                        <CheckBox x:Name="AskWhereToSaveCheck" Content="Ask where to save each download"
                                  ToolTip="Shows a Save-As dialog for every file"/>
                        <CheckBox x:Name="NotifyDownloadCompleteCheck" Content="Tell me when a download finishes while the window is hidden"
                                  ToolTip="Shows a tray balloon naming the file. Off by default; never makes a sound"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,0,0">
                            <TextBlock Text="If the file already exists:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="CollisionPolicyCombo" Width="210"
                                      ToolTip="Save under a new name automatically, or ask where to save that file"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,0,0">
                            <TextBlock Text="Keep download history:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="HistoryCapCombo" Width="120"
                                      ToolTip="How many finished downloads the Downloads window remembers"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Note}"
                                   Text="History keeps names, sizes, dates, and paths only — never the addresses files came from. Failed downloads are listed too."/>
                    </StackPanel>
                </Border>

                <Border x:Name="SectionData" Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock x:Name="HeaderData" Text="Data" Style="{StaticResource SectionHeader}"/>
                        <Border Height="2" Width="44" CornerRadius="1" Background="{StaticResource AccentBrush}"
                                HorizontalAlignment="Left" Margin="6,0,0,10"/>
                        <TextBlock Style="{StaticResource Note}" Margin="0,0,0,0"
                                   Text="Clearing browsing data (cookies, cache, site data) moved to Privacy &amp; security below, where you can choose exactly what to clear and for which profiles."/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Open data folder" Width="130" Click="OnOpenDataFolder"
                                    ToolTip="Open the folder with settings, logs, and download history in File Explorer"/>
                            <Button Content="Backup guide…" Width="130" Margin="8,0,0,0" Click="OnBackupGuide"
                                    ToolTip="Exactly what to copy to back up your sign-ins, and what an export does and doesn't cover"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Export settings…" Width="130" Click="OnExportSettings"
                                    ToolTip="Save these settings to a file you can keep or move to another PC"/>
                            <Button Content="Import settings…" Width="130" Margin="8,0,0,0" Click="OnImportSettings"
                                    ToolTip="Replace these settings with ones from an exported file"/>
                        </StackPanel>
                        <TextBlock x:Name="ImportNote" Style="{StaticResource Note}" AutomationProperties.Name="Settings import/export status" AutomationProperties.LiveSetting="Polite"
                                   Text="Export saves the settings shown here (including profiles and per-profile start pages) as a small JSON file. Sign-ins themselves are not exported — those stay in each profile's own data."/>
                        <Button Content="Reset all settings to defaults…" Width="230" HorizontalAlignment="Left"
                                Margin="0,12,0,0" Click="OnResetSettings"
                                ToolTip="Restores every preference to its default. Your current settings are exported to a backup file first; profiles, sign-ins, and downloads are not touched"/>
                        <TextBlock x:Name="ResetNote" Style="{StaticResource Note}" AutomationProperties.Name="Settings reset status" AutomationProperties.LiveSetting="Polite"
                                   Text="Reset restores preferences only — profiles, sign-ins, last pages, and downloaded files stay exactly as they are. A backup of your current settings is saved first, so Import can undo it."/>
                        <Button Content="Reset ArenaDesktop…" Width="230" HorizontalAlignment="Left"
                                Margin="0,12,0,0" Click="OnOpenResetWizard"
                                ToolTip="The guided reset: backup first, then choose — reset settings, clear site data for all profiles, or both — each step explained"/>
                        <TextBlock Style="{StaticResource Note}"
                                   Text="Won't start, or won't sign in? The guided reset walks through the fix step by step — a backup of your current settings is written before anything changes."/>
                        <TextBlock Text="Automatic backups:" Style="{StaticResource SubHeader}"/>
                        <TextBlock Style="{StaticResource Note}" Margin="0,0,0,0"
                                   Text="ArenaDesktop keeps the five most recent backups of your settings and your downloads history — at most one new automatic backup per day, plus whenever you choose Back up now. Restoring settings goes through the same checks as Import."/>
                        <Button Content="Back up now" Width="130" HorizontalAlignment="Left" Margin="0,6,0,0"
                                Click="OnBackupNow"
                                ToolTip="Write a fresh backup of settings and downloads history right now"/>
                        <StackPanel x:Name="BackupRows" Margin="0,6,0,0"/>
                        <TextBlock x:Name="BackupNote" Style="{StaticResource Note}" AutomationProperties.Name="Backup restore status" AutomationProperties.LiveSetting="Polite" Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock x:Name="PortableNote" Style="{StaticResource Note}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <Border x:Name="SectionPrivacy" Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock x:Name="HeaderPrivacy" Text="Privacy &amp; security" Style="{StaticResource SectionHeader}"/>
                        <Border Height="2" Width="44" CornerRadius="1" Background="{StaticResource AccentBrush}"
                                HorizontalAlignment="Left" Margin="6,0,0,10"/>

                        <CheckBox x:Name="PasswordAutosaveCheck" Content="Let Arena save passwords in the web view"
                                  ToolTip="WebView2's own password save, on by default. Turning this off stops NEW passwords being saved; ones already saved still fill until you clear site data"/>
                        <CheckBox x:Name="GeneralAutofillCheck" Content="Let the web view remember and refill form entries"
                                  ToolTip="WebView2's general autofill for ordinary form fields, on by default"/>
                        <TextBlock Style="{StaticResource Note}"
                                   Text="These are the web engine's features, shared by every window in the profile. They apply to the profile ArenaDesktop is currently running and take effect as soon as you choose OK."/>

                        <TextBlock Text="Clear browsing data:" Style="{StaticResource SubHeader}"/>
                        <StackPanel Orientation="Horizontal">
                            <ComboBox x:Name="ClearChoiceCombo" Width="140" SelectionChanged="OnClearChoiceChanged"
                                      ToolTip="What to clear: cookies only, cache only, or all site data"/>
                            <ComboBox x:Name="ClearScopeCombo" Width="150" Margin="8,0,0,0" SelectionChanged="OnClearChoiceChanged"
                                      ToolTip="Clear just the profile you're using, or every profile on this PC"/>
                            <Button x:Name="ClearNowButton" Content="Clear…" Width="76" Margin="8,0,0,0" Click="OnClearDataGranular"
                                    ToolTip="Clear the chosen data now (you'll be asked to confirm, with exactly what it does)"/>
                        </StackPanel>
                        <TextBlock x:Name="ClearPlanNote" Style="{StaticResource Note}"/>
                        <TextBlock x:Name="ClearResultNote" Style="{StaticResource Note}" AutomationProperties.Name="Clear data result" AutomationProperties.LiveSetting="Polite" Foreground="{StaticResource AccentBrush}"/>

                        <TextBlock Text="Permissions (profile ArenaDesktop is currently running):" Style="{StaticResource SubHeader}"/>
                        <TextBlock x:Name="PermissionsNote" Style="{StaticResource Note}" AutomationProperties.Name="Saved permissions status" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,0"
                                   Text="Reading the saved permission choices…"/>
                        <StackPanel x:Name="PermissionRows" Margin="0,4,0,0"/>
                        <Button Content="Refresh permissions" Width="150" HorizontalAlignment="Left" Margin="0,6,0,0"
                                Click="OnRefreshPermissions"
                                ToolTip="Read the running profile's saved permission choices again"/>
                        <TextBlock x:Name="PermissionDenialsText" Style="{StaticResource Note}"/>

                        <TextBlock Text="Microphone &amp; notification tests:" Style="{StaticResource SubHeader}"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Test microphone…" Width="140" Click="OnTestMicrophone"
                                    ToolTip="Ask for the microphone the way a page does, then listen for a few seconds — the result says whether permission was granted AND whether sound actually arrived"/>
                            <Button Content="Send test notification" Width="160" Margin="8,0,0,0" Click="OnTestNotification"
                                    ToolTip="Show a test tray notification now. A test you ask for is sent even during quiet hours — the result line says if automatic notifications are being held back"/>
                        </StackPanel>
                        <TextBlock x:Name="SelfTestResultText" Style="{StaticResource Note}" Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Style="{StaticResource Note}"
                                   Text="The microphone test runs in this profile and checks the whole path Arena's voice input uses — Windows' microphone permission included. The notification test fires ArenaDesktop's own tray balloon; Arena's in-page alerts are Arena's side of the fence."/>

                        <TextBlock Text="Site data per profile:" Style="{StaticResource SubHeader}"/>
                        <StackPanel x:Name="SiteDataRows"/>
                        <Button Content="Refresh site data" Width="150" HorizontalAlignment="Left" Margin="0,6,0,0"
                                Click="OnRefreshSiteData"
                                ToolTip="Measure each profile's data folder and count its cookies again"/>
                        <TextBlock Style="{StaticResource Note}"
                                   Text="Cookie counts only — cookie values are never shown anywhere in ArenaDesktop."/>

                        <TextBlock Text="App lock:" Style="{StaticResource SubHeader}"/>
                        <TextBlock x:Name="AppLockStatusText" Style="{StaticResource Note}" Margin="0,0,0,0"/>
                        <CheckBox x:Name="AppLockEnabledCheck" Content="Require my app password or PIN"
                                  Margin="0,6,0,0"
                                  ToolTip="Ask for the app password at startup and whenever the app is locked. Setting the check asks you to create the password if you haven't yet"
                                  Checked="OnAppLockEnabledChanged" Unchecked="OnAppLockEnabledChanged"/>
                        <CheckBox x:Name="AppLockTrayHideCheck" Content="Also lock when the window hides to the tray"
                                  ToolTip="On by default. Startup locking and Lock now apply either way"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="Lock after" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="AppLockIdleCombo" Width="120" SelectionChanged="OnAppLockIdleChanged"
                                      ToolTip="Lock itself after this long with no keyboard or mouse input anywhere on the PC. Off by default"
                                      AutomationProperties.Name="Lock after idle time"/>
                            <TextBlock Text="with no input" VerticalAlignment="Center" Margin="6,0,0,0"
                                       Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                        <TextBlock x:Name="AppLockIdleNote" Style="{StaticResource Note}" Margin="0,4,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button x:Name="SetLockPasswordButton" Content="Set or change password…" Width="170" Click="OnSetLockPassword"
                                    ToolTip="Set a new app password or PIN (4–64 characters; 6 or more is better)"/>
                            <Button x:Name="RemoveLockPasswordButton" Content="Remove password…" Width="140" Margin="8,0,0,0" Click="OnRemoveLockPassword"
                                    ToolTip="Remove the app password and turn the lock off"/>
                        </StackPanel>
                        <TextBlock x:Name="AppLockNote" Style="{StaticResource Note}" Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Style="{StaticResource Note}"
                                   Text="The lock stops casual access to the open app on this PC. It does NOT encrypt your Arena sign-ins on disk. Only a salted one-way hash of the password is stored — the password itself never is. If you forget it: quit ArenaDesktop, open the data folder (Data section above) and delete settings.json, then start the app — the lock is gone and settings return to defaults; your default profile stays signed in, because sign-ins live in the separate profile folders, not in settings.json."/>

                        <TextBlock Text="Privacy report:" Style="{StaticResource SubHeader}"/>
                        <TextBlock x:Name="PrivacyReportText" Style="{StaticResource Note}" Margin="0,0,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="Reset counters" Width="120" Click="OnResetPrivacyStats"
                                    ToolTip="Start the privacy report's counts over from today"/>
                            <Button Content="View log…" Width="120" Margin="8,0,0,0" Click="OnViewLog"
                                    ToolTip="Read the diagnostic log in the app, with its redaction check and a copy-redacted button"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Note}"
                                   Text="The report counts only — what kind of thing was blocked, how many times, and which site. No page addresses, no content, and nothing leaves this PC."/>
                    </StackPanel>
                </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
