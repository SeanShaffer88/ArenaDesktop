<Window x:Class="ArenaDesktop.LogViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ArenaDesktop log"
        Width="760" Height="560" MinWidth="520" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        KeyDown="OnWindowKeyDown">
    <Window.Resources>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="14,12,14,12">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="AuditText" Style="{StaticResource Note}" Margin="0,0,0,0"
                       AutomationProperties.Name="Redaction check result"/>
            <TextBlock x:Name="FindingsText" Style="{StaticResource Note}"
                       AutomationProperties.Name="Redaction findings by line"/>
            <!-- Hardening pack: find. The log is up to a megabyte of text
                 and the reason to open it is to locate one line. -->
            <DockPanel Margin="0,8,0,0">
                <TextBlock Text="Find" VerticalAlignment="Center" Margin="0,0,6,0"
                           Foreground="{StaticResource MutedBrush}"/>
                <Button x:Name="FindNextButton" DockPanel.Dock="Right" Content="Next" Width="60" Height="28"
                        Margin="6,0,0,0" Click="OnFindNext"
                        ToolTip="Jump to the next match (Enter in the box does the same)"/>
                <Button x:Name="FindPreviousButton" DockPanel.Dock="Right" Content="Previous" Width="70" Height="28"
                        Margin="6,0,0,0" Click="OnFindPrevious"
                        ToolTip="Jump to the previous match (Shift+Enter in the box does the same)"/>
                <TextBlock x:Name="FindStatus" DockPanel.Dock="Right" VerticalAlignment="Center"
                           Margin="8,0,0,0" FontSize="11"
                           Foreground="{StaticResource MutedBrush}"
                           MinWidth="104" TextAlignment="Right"
                           AutomationProperties.Name="Find results count"
                           AutomationProperties.LiveSetting="Polite"/>
                <TextBox x:Name="FindBox" Height="28" VerticalContentAlignment="Center"
                         Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"
                         BorderBrush="{StaticResource HairlineBrush}"
                         TextChanged="OnFindChanged" KeyDown="OnFindKeyDown"
                         AutomationProperties.Name="Find in the log"/>
            </DockPanel>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <TextBlock x:Name="CopyNote" Style="{StaticResource Note}" Margin="0,4,10,0"/>
            <Button Content="Copy redacted log" Width="140" Height="30" Click="OnCopyRedacted"
                    ToolTip="Copy the log with anything the redaction check flagged removed first"/>
            <Button Content="Copy last error" Width="120" Height="30" Margin="8,0,0,0" Click="OnCopyLastError"
                    ToolTip="Copy just the most recent ERROR line (redacted) — the one line a bug report usually needs"/>
            <Button Content="Open today's log" Width="120" Height="30" Margin="8,0,0,0" Click="OnOpenLog"
                    ToolTip="Open the log file itself in your default text editor"/>
            <Button Content="Refresh" Width="86" Height="30" Margin="8,0,0,0" Click="OnRefresh"
                    ToolTip="Read the log file again"/>
            <Button Content="Close" Width="86" Height="30" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>

        <TextBox x:Name="LogText" Margin="0,10,0,0" IsReadOnly="True"
                 FontFamily="Consolas" FontSize="12"
                 Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"
                 BorderBrush="{StaticResource HairlineBrush}"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap"
                 AutomationProperties.Name="Log contents"/>
    </DockPanel>
</Window>
