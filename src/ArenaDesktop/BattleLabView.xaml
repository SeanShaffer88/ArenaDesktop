<UserControl x:Class="ArenaDesktop.BattleLabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
    <!-- Battle Lab as a control (v0.8.0): the same library, editor,
         queue and journal that used to live in their own window, now
         dropped into the main window's side pane. The three columns are
         the original window's numbers; SplitWorkspace decides whether
         they sit side by side, fold into two, or become one tabbed
         column — see ApplyArrangement in the code-behind. -->
    <UserControl.Resources>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
        </Style>
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource RaisedBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <!-- The pane's own tab strip, shown only in the tabbed arrangement. -->
        <Style x:Key="PaneTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chip" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush"
                                        Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chip" Property="Background"
                                        Value="{StaticResource RaisedBrush}"/>
                                <Setter TargetName="Chip" Property="BorderBrush"
                                        Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush"
                                        Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12,10,12,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: the pane is closed from here, so the ✕ has to be
             reachable with a screen reader and a keyboard like the rest. -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="Battle Lab" FontSize="19" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText" Style="{StaticResource Note}" Margin="14,4,0,0"
                           VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}"
                           TextTrimming="CharacterEllipsis" MaxWidth="420"
                           AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
            <Button x:Name="ClosePaneButton" Grid.Column="1" Content="✕" Width="28" Height="26"
                    Click="OnClosePane" ToolTip="Close Battle Lab (Ctrl+Shift+B)"
                    AutomationProperties.Name="Close Battle Lab"/>
        </Grid>

        <!-- The tab strip exists only in the tabbed arrangement; the
             three real columns live below it and are hidden/re-shown. -->
        <StackPanel x:Name="PaneTabs" Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8"
                    Visibility="Collapsed">
            <RadioButton x:Name="PromptsTab" Style="{StaticResource PaneTab}" Content="Prompts"
                         GroupName="LabPane" IsChecked="True" Click="OnPaneTab"
                         AutomationProperties.Name="Prompts tab"/>
            <RadioButton x:Name="EditorTab" Style="{StaticResource PaneTab}" Content="Editor"
                         GroupName="LabPane" Click="OnPaneTab" AutomationProperties.Name="Editor tab"/>
            <RadioButton x:Name="JournalTab" Style="{StaticResource PaneTab}" Content="Journal"
                         GroupName="LabPane" Click="OnPaneTab" AutomationProperties.Name="Journal tab"/>
        </StackPanel>

        <!-- The three columns. Re-parented into this grid by hand when the
             arrangement changes, so they are named and kept here only as
             the initial layout. -->
        <Grid x:Name="LabGrid" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LibraryColumn" Width="272"/>
                <ColumnDefinition x:Name="EditorColumn" Width="*"/>
                <ColumnDefinition x:Name="JournalColumn" Width="356"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TopRow" Height="*"/>
                <RowDefinition x:Name="BottomRow" Height="0"/>
            </Grid.RowDefinitions>

            <!-- Prompt library -->
            <Border x:Name="LibraryPanel" Grid.Row="0" Grid.Column="0" Style="{StaticResource Panel}"
                    Margin="0,0,10,0" AutomationProperties.Name="Prompt library panel">
                <DockPanel>
                    <TextBlock Text="Prompt library" Style="{StaticResource Section}" DockPanel.Dock="Top"/>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Button x:Name="NewPromptButton" Content="+ New prompt" Height="32" Click="OnNewPrompt"
                                ToolTip="Add a prompt to the library" AutomationProperties.Name="New prompt"/>
                        <Button x:Name="DeletePromptButton" Content="Delete prompt" Height="28" Margin="0,6,0,0"
                                Click="OnDeletePrompt" ToolTip="Delete the selected prompt (journal entries keep their history)"
                                AutomationProperties.Name="Delete prompt"/>
                        <Button x:Name="DuplicatePromptButton" Content="Duplicate" Height="28" Margin="0,6,0,0"
                                Click="OnDuplicatePrompt" ToolTip="Copy the selected prompt — the copy is named '… copy'"
                                AutomationProperties.Name="Duplicate prompt"/>
                        <Button x:Name="ExportLibraryButton" Content="Export library…" Height="28" Margin="0,6,0,0"
                                Click="OnExportLibrary" ToolTip="Save the whole prompt library as a JSON file you can share or keep"
                                AutomationProperties.Name="Export library"/>
                        <Button x:Name="ImportLibraryButton" Content="Import library…" Height="28" Margin="0,6,0,0"
                                Click="OnImportLibrary" ToolTip="Merge a library file into this one — you choose what happens when a title is already here"
                                AutomationProperties.Name="Import library"/>
                        <Button x:Name="FindDuplicatesButton" Content="Find duplicates" Height="28" Margin="0,6,0,0"
                                Click="OnFindDuplicates" ToolTip="List prompts whose text is identical, or whose name is used more than once"
                                AutomationProperties.Name="Find duplicates"/>
                    </StackPanel>
                    <TextBox x:Name="SearchText" DockPanel.Dock="Top" Height="26" Margin="0,0,0,8"
                             Style="{StaticResource Field}" TextChanged="OnSearchChanged"
                             ToolTip="Search by name, category, or prompt text" AutomationProperties.Name="Search prompts"/>
                    <ListBox x:Name="PromptList" Background="Transparent" BorderThickness="0"
                             Foreground="{StaticResource TextBrush}"
                             SelectionChanged="OnPromptSelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="Prompt library">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4,4">
                                    <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding CategoryLabel}" FontSize="11"
                                               Foreground="{StaticResource MutedBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Editor + queue -->
            <Grid x:Name="EditorPanel" Grid.Row="0" Grid.Column="1" Margin="0,0,10,0"
                  AutomationProperties.Name="Prompt editor panel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="196"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Panel}" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBox x:Name="PromptNameText" Grid.Row="0" FontSize="15" FontWeight="SemiBold"
                                 Style="{StaticResource Field}" Height="30"
                                 TextChanged="OnEditorChanged" AutomationProperties.Name="Prompt name"/>
                        <ComboBox x:Name="PromptCategoryCombo" Grid.Row="1" Width="190" HorizontalAlignment="Left"
                                  Margin="0,8,0,0" IsEditable="True" IsTextSearchEnabled="False"
                                  LostFocus="OnCategoryCommitted" AutomationProperties.Name="Prompt category"
                                  ToolTip="Category — pick an existing one or type a new one"/>
                        <TextBox x:Name="PromptBodyText" Grid.Row="2" Margin="0,10,0,0"
                                 Style="{StaticResource Field}" VerticalContentAlignment="Top"
                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 TextChanged="OnEditorChanged" AutomationProperties.Name="Prompt text"
                                 ToolTip="The prompt text. Square brackets like [topic] are blanks you fill in at copy time."/>
                        <TextBlock x:Name="BlanksHint" Grid.Row="3" Style="{StaticResource Note}" Margin="0,8,0,0"
                                   Text="Blanks like [topic] ask you to fill them in each run."/>
                        <!-- Wraps rather than clips: in a narrow pane the
                             longest of these buttons is wider than the
                             column, and a horizontal scroller would hide
                             the primary action. -->
                        <WrapPanel Grid.Row="4" Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="CopyButton" Content="Copy prompt &amp; open Battle" Height="36" Padding="18,0"
                                    Click="OnCopyAndOpenBattle" IsDefault="True"
                                    Background="{StaticResource AccentFillBrush}" Foreground="{StaticResource AccentTextBrush}"
                                    BorderThickness="0" FontWeight="SemiBold"
                                    ToolTip="Fill in any blanks, copy the finished prompt, and bring the picked page forward so you can paste it"
                                    AutomationProperties.Name="Copy prompt and open Battle"/>
                            <ComboBox x:Name="CopyTargetCombo" Height="36" Width="132" Margin="8,0,0,0"
                                      DisplayMemberPath="Label" SelectionChanged="OnCopyTargetChanged"
                                      VerticalContentAlignment="Center"
                                      ToolTip="The page the copy button opens: Battle, Direct Chat, or Side by Side"
                                      AutomationProperties.Name="Copy target page"/>
                            <Button x:Name="QueueButton" Content="Add to run queue" Height="36" Padding="16,0"
                                    Margin="10,0,0,0" Click="OnAddToQueue"
                                    ToolTip="Line this prompt up in the run queue" AutomationProperties.Name="Add to run queue"/>
                        </WrapPanel>
                    </Grid>
                </Border>

                <Border x:Name="QueuePanel" Grid.Row="1" Style="{StaticResource Panel}">
                    <DockPanel>
                        <TextBlock Text="Run queue" Style="{StaticResource Section}" DockPanel.Dock="Top"/>
                        <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <Button x:Name="UseNextButton" Content="Use next from queue" Height="28" Padding="10,0"
                                    Click="OnUseNext" ToolTip="Fill in and copy the first prompt in the queue, and open the page picked beside the copy button"
                                    AutomationProperties.Name="Use next from queue"/>
                            <Button Content="↑" Width="30" Height="28" Margin="8,0,0,0" Click="OnQueueMoveUp"
                                    ToolTip="Move the selected prompt up" AutomationProperties.Name="Move queue item up"/>
                            <Button Content="↓" Width="30" Height="28" Margin="4,0,0,0" Click="OnQueueMoveDown"
                                    ToolTip="Move the selected prompt down" AutomationProperties.Name="Move queue item down"/>
                            <Button Content="Remove" Height="28" Padding="10,0" Margin="8,0,0,0" Click="OnQueueRemove"
                                    ToolTip="Take the selected prompt out of the queue" AutomationProperties.Name="Remove from queue"/>
                            <Button Content="Clear" Height="28" Padding="10,0" Margin="4,0,0,0" Click="OnQueueClear"
                                    ToolTip="Empty the run queue" AutomationProperties.Name="Clear queue"/>
                            <Button x:Name="EnqueueCategoryButton" Content="Add category to queue" Height="28" Padding="10,0"
                                    Margin="8,0,0,0" Click="OnEnqueueCategory"
                                    ToolTip="Line up every prompt in the selected prompt's category that isn't queued yet"
                                    AutomationProperties.Name="Add category to queue"/>
                        </WrapPanel>
                        <ListBox x:Name="QueueList" Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource TextBrush}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 AutomationProperties.Name="Run queue">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="13"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Text="{Binding State}" FontSize="11"
                                                   Foreground="{StaticResource MutedBrush}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Results journal -->
            <Border x:Name="JournalPanel" Grid.Row="0" Grid.Column="2" Style="{StaticResource Panel}"
                    AutomationProperties.Name="Results journal panel">
                <DockPanel>
                    <TextBlock Text="Results journal" Style="{StaticResource Section}" DockPanel.Dock="Top"/>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Button x:Name="LogResultButton" Content="+ Log a result" Height="32" Click="OnLogResult"
                                ToolTip="Record a Battle result by hand" AutomationProperties.Name="Log a result"/>
                        <Button Content="Delete entry" Height="28" Margin="0,6,0,0" Click="OnDeleteJournalEntry"
                                ToolTip="Delete the selected journal entry" AutomationProperties.Name="Delete journal entry"/>
                        <Button x:Name="ExportJournalButton" Content="Export journal…" Height="28" Margin="0,6,0,0"
                                Click="OnExportJournal" ToolTip="Save the journal entries shown (after the filter) as a Markdown file"
                                AutomationProperties.Name="Export journal"/>
                    </StackPanel>
                    <TextBox x:Name="JournalFilterText" DockPanel.Dock="Top" Height="26" Margin="0,0,0,8"
                             Style="{StaticResource Field}" TextChanged="OnJournalFilterChanged"
                             ToolTip="Filter the journal by prompt name" AutomationProperties.Name="Filter journal by prompt name"/>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <ComboBox x:Name="JournalModeCombo" Width="126" Height="26"
                                  DisplayMemberPath="Label" SelectionChanged="OnJournalFilterControlChanged"
                                  VerticalContentAlignment="Center"
                                  ToolTip="Show only battles recorded in one mode" AutomationProperties.Name="Filter journal by mode"/>
                        <ComboBox x:Name="JournalRangeCombo" Width="118" Height="26" Margin="8,0,0,0"
                                  DisplayMemberPath="Label" SelectionChanged="OnJournalFilterControlChanged"
                                  VerticalContentAlignment="Center"
                                  ToolTip="Show only battles from the last 7 or 30 days" AutomationProperties.Name="Filter journal by date range"/>
                    </StackPanel>
                    <TextBlock x:Name="ScoreboardText" DockPanel.Dock="Top" Margin="0,0,0,8"
                               FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                               AutomationProperties.Name="Journal scoreboard"/>
                    <ListBox x:Name="JournalList" Background="Transparent" BorderThickness="0"
                             Foreground="{StaticResource TextBrush}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="Results journal">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource RaisedBrush}"
                                        BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
                                        CornerRadius="5" Padding="9" Margin="0,0,0,8">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding PromptName}" FontSize="13"
                                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1" Text="{Binding When}" FontSize="11"
                                                       Foreground="{StaticResource MutedBrush}"/>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <Border Background="{Binding ChipBrush}" CornerRadius="4" Padding="7,2">
                                                <TextBlock Text="{Binding OutcomeLabel}" FontSize="11" FontWeight="Bold"
                                                           Foreground="White"/>
                                            </Border>
                                            <TextBlock Text="{Binding ModeLabel}" FontSize="11" Margin="8,2,0,0"
                                                       Foreground="{StaticResource MutedBrush}"/>
                                            <TextBlock Text="{Binding Note}" FontSize="11" Margin="8,2,0,0"
                                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3" Style="{StaticResource Note}" Margin="0,8,0,0"
                   Text="Nothing is scraped from arena.ai — you record winners and notes yourself."/>
    </Grid>
</UserControl>
