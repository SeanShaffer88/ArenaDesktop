<Window x:Class="ArenaDesktop.ScriptsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Script commands"
        Width="680" Height="480" MinWidth="520" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
    <Window.Resources>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource RaisedBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}"/>
            <Setter Property="Margin" Value="0,2,0,8"/>
        </Style>
    </Window.Resources>
    <Grid Margin="14,12,14,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Style="{StaticResource Note}"
                   Text="Your own commands, offered in the command palette (Ctrl+K) under Scripts and run in the terminal. The palette shows the full command text before you run it. These are your commands on your machine — ArenaDesktop never loads third-party code into itself."/>
        <ListBox x:Name="ScriptList" Grid.Row="1" Margin="0,10,0,10"
                 Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"
                 SelectionChanged="OnSelectionChanged" AutomationProperties.Name="Script commands"/>
        <StackPanel Grid.Row="2">
            <TextBlock Text="Name"/>
            <TextBox x:Name="NameBox" Style="{StaticResource Field}" AutomationProperties.Name="Script name"/>
            <TextBlock Text="Command (run with the Windows shell, in the folder below)"/>
            <TextBox x:Name="CommandBox" Style="{StaticResource Field}" FontFamily="Consolas" AutomationProperties.Name="Script command"/>
            <TextBlock Text="Working folder (blank = the project folder)"/>
            <TextBox x:Name="FolderBox" Style="{StaticResource Field}" AutomationProperties.Name="Script working folder"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,4,0,0">
            <Button Content="Add new" Click="OnAdd" Margin="0,0,6,0" AutomationProperties.Name="Add script command"/>
            <Button Content="Remove" Click="OnRemove" AutomationProperties.Name="Remove script command"/>
        </StackPanel>
    </Grid>
</Window>
