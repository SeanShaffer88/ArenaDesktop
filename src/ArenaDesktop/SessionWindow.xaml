<Window x:Class="ArenaDesktop.SessionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="This session"
        Width="440" Height="380" MinWidth="360" MinHeight="280"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        AutomationProperties.Name="This session">
    <Window.Resources>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="16,14,16,14">
        <TextBlock DockPanel.Dock="Top" FontSize="16" FontWeight="SemiBold"
                   TextWrapping="Wrap" Text="This session"
                   AutomationProperties.Name="Session headline"/>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Note}"
                   Text="Counted in memory while ArenaDesktop is running. Nothing here is written to disk, and nothing leaves this PC."/>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="CopyButton" Content="Copy summary" Width="120" Height="30" Click="OnCopy"
                    ToolTip="Put these numbers on the clipboard as plain text"/>
            <Button Content="Close" Width="80" Height="30" Margin="8,0,0,0" IsCancel="True" Click="OnClose"/>
        </StackPanel>

        <TextBlock DockPanel.Dock="Top" x:Name="AnnotationText" Style="{StaticResource Note}" Visibility="Collapsed"/>

        <TextBlock DockPanel.Dock="Top" x:Name="SummaryText" Margin="0,12,0,0" FontSize="13"
                   TextWrapping="Wrap" AutomationProperties.Name="Session summary"/>

        <DockPanel Margin="0,12,0,0">
            <TextBlock DockPanel.Dock="Top" Text="Reading time by mode" FontWeight="SemiBold" Margin="0,0,0,6"
                       Visibility="Collapsed" x:Name="ModeHeadingText"/>
            <ListBox x:Name="ModeList" Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"
                     BorderBrush="{StaticResource HairlineBrush}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="Reading time by mode">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="4,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="1" Text="{Binding Duration}" FontSize="13" FontWeight="SemiBold"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </DockPanel>
</Window>
