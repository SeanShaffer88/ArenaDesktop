<Window x:Class="ArenaDesktop.FieldPassWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Field pass"
        Width="1080" Height="680" MinWidth="860" MinHeight="540"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
    <Window.Resources>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
        </Style>
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource RaisedBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14,12,14,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Field pass" FontSize="19" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="prove the app on this PC, one check at a time" Style="{StaticResource Note}"
                       Margin="10,4,0,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="ProgressText" Grid.Column="2" Style="{StaticResource Note}" Margin="18,4,0,0"
                       VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}"
                       AutomationProperties.Name="Field pass progress"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="272"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Step list + progress + actions -->
            <Border Grid.Column="0" Style="{StaticResource Panel}" Margin="0,0,10,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <TextBlock Text="Progress" Style="{StaticResource Note}" Margin="0,0,0,4"/>
                        <ProgressBar x:Name="ProgressBar" Height="8" Minimum="0" Maximum="9" Value="0"
                                     Foreground="{StaticResource AccentBrush}" Background="{StaticResource RaisedBrush}"
                                     BorderThickness="0" AutomationProperties.Name="Checks completed"/>
                        <TextBlock x:Name="CountsText" Style="{StaticResource Note}" Margin="0,6,0,0"/>
                        <Button x:Name="CopySummaryButton" Content="Copy summary" Height="32" Margin="0,12,0,0"
                                Click="OnCopySummary"
                                ToolTip="Copy the whole pass — verdicts and notes — as plain text for a bug report"
                                AutomationProperties.Name="Copy summary"/>
                        <Button Content="Start over" Height="28" Margin="0,6,0,0" Click="OnReset"
                                ToolTip="Clear every verdict and note and begin the pass again (asks first)"
                                AutomationProperties.Name="Start the field pass over"/>
                    </StackPanel>
                    <ListBox x:Name="StepList" Background="Transparent" BorderThickness="0"
                             Foreground="{StaticResource TextBrush}"
                             SelectionChanged="OnStepSelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="Field pass checks">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding RowBackground}" BorderBrush="{StaticResource HairlineBrush}"
                                        BorderThickness="{Binding RowBorderThickness}" CornerRadius="5"
                                        Padding="8,6" Margin="0,0,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Marker}" FontSize="13" FontWeight="Bold"
                                                   Foreground="{Binding MarkerBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="13"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Current check -->
            <Border Grid.Column="1" Style="{StaticResource Panel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="StepTitle" Grid.Row="0" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Grid.Row="1" Text="What to do:" Style="{StaticResource Section}" Margin="0,14,0,4"/>
                    <TextBlock x:Name="InstructionsText" Grid.Row="2" FontSize="13" TextWrapping="Wrap"/>
                    <TextBlock Grid.Row="3" Text="Working looks like:" Style="{StaticResource Section}" Margin="0,14,0,4"/>
                    <TextBlock x:Name="SuccessText" Grid.Row="4" FontSize="13" TextWrapping="Wrap"/>
                    <Button x:Name="OpenFeatureButton" Grid.Row="5" Content="Open feature" Height="32" Padding="16,0"
                            HorizontalAlignment="Left" Margin="0,14,0,0" Click="OnOpenFeature"
                            ToolTip="Open the window this check is about" AutomationProperties.Name="Open the feature for this check"/>
                    <StackPanel Grid.Row="7">
                        <TextBlock Text="Notes (optional)" Style="{StaticResource Note}" Margin="0,0,0,4"/>
                        <TextBox x:Name="NoteText" Height="64" Style="{StaticResource Field}"
                                 VerticalContentAlignment="Top" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 ToolTip="Anything worth recording about this check — it is saved on this PC as you go"
                                 AutomationProperties.Name="Notes for this check"/>
                    </StackPanel>
                    <StackPanel Grid.Row="8" Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="PassButton" Content="Pass" Height="36" Padding="26,0" Click="OnPass"
                                    Background="{StaticResource AccentFillBrush}" Foreground="{StaticResource AccentTextBrush}"
                                    BorderThickness="0" FontWeight="SemiBold"
                                    ToolTip="It worked the way the check describes" AutomationProperties.Name="Mark this check as passed"/>
                            <Button Content="It has a problem" Height="36" Padding="18,0" Margin="10,0,0,0" Click="OnProblem"
                                    ToolTip="Something was wrong — the note above says what" AutomationProperties.Name="Mark this check as having a problem"/>
                            <Button Content="Skip for now" Height="36" Padding="18,0" Margin="10,0,0,0" Click="OnSkip"
                                    ToolTip="Leave this check out — it doesn't apply, or it's for later" AutomationProperties.Name="Skip this check"/>
                        </StackPanel>
                        <TextBlock x:Name="VerdictText" Style="{StaticResource Note}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{StaticResource Note}" VerticalAlignment="Center"
                       Text="Closing this window keeps your progress — every answer is saved on this PC as you go. These checks record what you saw; the app doesn't verify them by itself."/>
            <TextBlock x:Name="StatusText" Grid.Column="1" Style="{StaticResource Note}" Margin="14,0,0,0"
                       VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}"/>
        </Grid>
    </Grid>
</Window>
