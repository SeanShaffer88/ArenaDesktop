<UserControl x:Class="ArenaDesktop.Rendering.ArenaRenderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <!-- Replit-style streamed-response surface. All rendering logic lives in
         ArenaDesktop.Core.Rendering; this control only hosts WebView2 and
         forwards bridge messages (run / expand) as .NET events. -->
    <wv2:WebView2 x:Name="Web" />
</UserControl>
