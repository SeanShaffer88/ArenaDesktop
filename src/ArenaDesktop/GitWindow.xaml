<Window x:Class="ArenaDesktop.GitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Git — project folder"
        Width="920" Height="600" MinWidth="680" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
    <Window.Resources>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>
    <Grid Margin="14,12,14,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="Repository:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="RepoCombo" Width="420" SelectionChanged="OnRepoChanged" AutomationProperties.Name="Repository"/>
            <Button Content="Choose project folder…" Click="OnChooseFolder" Margin="8,0,0,0" AutomationProperties.Name="Choose project folder"/>
            <Button Content="Refresh" Click="OnRefresh" Margin="6,0,0,0"/>
        </StackPanel>
        <TextBlock x:Name="StatusText" Grid.Row="1" Style="{StaticResource Note}" Margin="0,8,0,6"/>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>
            <ListBox x:Name="FilesList" Grid.Column="0" SelectionMode="Extended" Margin="0,0,8,0"
                     Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"
                     SelectionChanged="OnFileSelected" AutomationProperties.Name="Changed files"/>
            <TextBox x:Name="DiffBox" Grid.Column="1" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"
                     AutomationProperties.Name="Diff"/>
        </Grid>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Stage selected" Click="OnStage" Margin="0,0,6,0"/>
            <Button Content="Unstage selected" Click="OnUnstage" Margin="0,0,6,0"/>
            <TextBlock Text="Branch:" VerticalAlignment="Center" Margin="10,0,6,0"/>
            <ComboBox x:Name="BranchCombo" Width="180" AutomationProperties.Name="Branch"/>
            <Button Content="Switch" Click="OnSwitchBranch" Margin="6,0,0,0"/>
            <Button Content="Pull" Click="OnPull" Margin="14,0,6,0"/>
            <Button Content="Push" Click="OnPush"/>
        </StackPanel>
        <Grid Grid.Row="4" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="CommitBox" Grid.Column="0" AutomationProperties.Name="Commit message"/>
            <Button Grid.Column="1" Content="Commit staged" Click="OnCommit" Margin="8,0,0,0" AutomationProperties.Name="Commit staged changes"/>
        </Grid>
    </Grid>
</Window>
