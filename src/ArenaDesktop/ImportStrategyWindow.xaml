<Window x:Class="ArenaDesktop.ImportStrategyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import library"
        Width="460" Height="Auto" MinWidth="380"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
    <StackPanel Margin="18,14,18,14">
        <TextBlock TextWrapping="Wrap"
                   Text="Some prompts in this file may have the same title as prompts already in your library. What should happen to those? Prompts with new titles are always added, and a prompt whose title and text both match is always skipped."/>
        <RadioButton x:Name="SkipRadio" Content="Skip them — keep what I have" GroupName="Strategy" IsChecked="True"
                     Margin="0,12,0,0" Foreground="{StaticResource TextBrush}"
                     AutomationProperties.Name="Skip clashing prompts"/>
        <RadioButton x:Name="ReplaceRadio" Content="Replace mine — the file's text and category take over" GroupName="Strategy"
                     Margin="0,8,0,0" Foreground="{StaticResource TextBrush}"
                     AutomationProperties.Name="Replace existing prompts"/>
        <RadioButton x:Name="KeepBothRadio" Content="Keep both — add the file's under a “… copy” name" GroupName="Strategy"
                     Margin="0,8,0,0" Foreground="{StaticResource TextBrush}"
                     AutomationProperties.Name="Keep both prompts"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Import" Width="96" Height="30" IsDefault="True" Click="OnOk"
                    Background="{StaticResource AccentFillBrush}" Foreground="{StaticResource AccentTextBrush}" BorderThickness="0"/>
            <Button Content="Cancel" Width="86" Height="30" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
