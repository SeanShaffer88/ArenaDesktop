<Window x:Class="ArenaDesktop.LibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Library — search &amp; export"
        Width="820" Height="560" MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
    <Window.Resources>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>
    <Grid Margin="14,12,14,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Style="{StaticResource Note}"
                   Text="Search everything ArenaDesktop itself stores: Battle Lab prompts and journal, prompt pad entries, download history. Your Arena conversations are not stored by the app (they live on Arena's servers), so they are not searchable or exportable here."/>
        <Grid Grid.Row="1" Margin="0,10,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Grid.Column="0" TextChanged="OnSearchChanged" AutomationProperties.Name="Search the library"/>
            <TextBlock x:Name="CountText" Grid.Column="1" Style="{StaticResource Note}" Margin="8,0,0,0" VerticalAlignment="Center"/>
        </Grid>
        <ListBox x:Name="ResultsList" Grid.Row="2"
                 Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"
                 AutomationProperties.Name="Library search results"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Export as JSON…" Click="OnExportJson" Margin="0,0,6,0" AutomationProperties.Name="Export library as JSON"/>
            <Button Content="Export as Markdown…" Click="OnExportMarkdown" AutomationProperties.Name="Export library as Markdown"/>
        </StackPanel>
    </Grid>
</Window>
