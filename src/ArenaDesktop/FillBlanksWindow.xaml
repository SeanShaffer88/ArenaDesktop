<Window x:Class="ArenaDesktop.FillBlanksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fill in the blanks"
        Width="440" Height="Auto" MinWidth="380" MaxHeight="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
    <StackPanel Margin="18,14,18,14">
        <TextBlock x:Name="PromptText" TextWrapping="Wrap"
                   Text="Fill in the blanks for this prompt. Anything left empty keeps its [blank] in the copied text."/>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
            <StackPanel x:Name="FieldsPanel"/>
        </ScrollViewer>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Copy" Width="86" Height="30" IsDefault="True" Click="OnOk"
                    Background="{StaticResource AccentFillBrush}" Foreground="{StaticResource AccentTextBrush}" BorderThickness="0"/>
            <Button Content="Cancel" Width="86" Height="30" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
